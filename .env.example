# Copiar a .env y completar. .env está en .gitignore: nunca commitearlo.
# Las variables ya definidas en el sistema tienen prioridad sobre este archivo.

# Firma de los tokens de sesión (JWT). Obligatoria en producción: sin ella se
# genera una clave temporal y todas las sesiones se cierran al reiniciar.
# Mínimo 32 caracteres (con menos la API no arranca). Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Publicar la documentación interactiva de la API (/docs, /redoc, /openapi.json). Apagada por defecto: en un servidor
# expuesto a internet muestra toda la superficie de la API. Solo para desarrollar: API_DOCS=1
API_DOCS=0

# Intentos fallidos de login (o de código de curso) que una misma dirección puede hacer antes de quedar fuera, y en cuántos
# minutos. Es aparte del bloqueo de cada cuenta (5 fallos).
INTENTOS_LOGIN_POR_IP=30
VENTANA_LOGIN_MINUTOS=10
# Solo detrás de un proxy: nombre de la cabecera donde el proxy escribe la dirección real de quien pide (el nginx de Docker
# usa X-IP-Cliente y ya lo configura el compose). NO la pongas si el servidor se puede alcanzar sin pasar por el proxy.
# CABECERA_IP_CLIENTE=X-IP-Cliente

# Horas que tiene el profesor para revisar el material de una clase antes de que se publique como
# "provisorio" (con advertencia para los alumnos). Por defecto 24.
HORAS_REVISION_PROFESOR=24

# Grabación de clases. Minutos después del término del bloque en que la grabación se corta sola
# (por si el profesor olvida terminarla). Por defecto 15.
MINUTOS_CORTE_GRABACION=15
# Cuántas clases se procesan a la vez (por defecto 1: el equipo del colegio es modesto). Súbelo solo con varias
# instancias de Ollama (el cluster del despliegue con Docker) y memoria de sobra.
PROCESAMIENTOS_SIMULTANEOS=1
# Modelo de Whisper que transcribe las clases (tiny, base, small, medium...). Por defecto small.
MODELO_WHISPER=small
# Limpieza de ruido del audio antes de transcribir: none, light_dsp (por defecto), dsp, heavy_dsp o mmse.
# `light_dsp` casi no toca el audio limpio y ayuda con ruido parejo (ventilador, proyector); los otros limpian
# más pero distorsionan más el audio limpio; ninguno separa un murmullo de voces. DeepFilterNet no se ofrece.
LIMPIEZA_AUDIO=light_dsp
# Carpeta temporal de los trozos de audio mientras se procesa una clase (se borran siempre al terminar).
AUDIO_TEMP_DIR=audio_temp
# Respaldo diario de la base de datos (horario, usuarios y texto de las clases; nunca audio). Para que sirva si el disco
# falla, apunta CARPETA_RESPALDOS a otro disco o a una unidad externa. Se guardan los últimos DIAS_DE_RESPALDO días.
CARPETA_RESPALDOS=respaldos
DIAS_DE_RESPALDO=14
# Carpeta temporal de las fotos de la pizarra (la imagen se borra apenas se lee). Que el colegio use o no las fotos NO se
# configura aquí: lo decide el UTP en «Ajustes» dentro de la aplicación (y la aplicación descarga el modelo de lectura sola).
FOTOS_TEMP_DIR=fotos_temp

# Dónde genera Ollama los resúmenes: `auto` (por defecto: donde Ollama decida, la GPU si la hay) o `cpu`. Con `cpu` la GPU
# queda libre para Whisper (la transcripción, que es lo más lento de una clase) y el resumen se hace en la CPU con el modelo
# liviano de 1B: una clase puede transcribirse en la GPU mientras otra genera su material en la CPU.
OLLAMA_DISPOSITIVO=auto
# Servidor de Ollama. Si se deja vacío se usa el de transcriber_config.json.
OLLAMA_URL=http://localhost:11434
