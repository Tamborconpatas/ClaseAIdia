# Copiar a .env y completar. .env está en .gitignore: nunca commitearlo.
# Las variables ya definidas en el sistema tienen prioridad sobre este archivo.

# Firma de los tokens de sesión (JWT). Obligatoria en producción: sin ella se
# genera una clave temporal y todas las sesiones se cierran al reiniciar.
# Mínimo 32 caracteres (con menos la API no arranca). Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Prototipo Gradio (app.py). 127.0.0.1 = solo este PC; 0.0.0.0 solo dentro de Docker.
SERVER_NAME=127.0.0.1
SERVER_PORT=7862

# Horas que tiene el profesor para revisar el material de una clase antes de que se publique como
# "provisorio" (con advertencia para los alumnos). Por defecto 24.
HORAS_REVISION_PROFESOR=24

# Servidor de Ollama. Si se deja vacío se usa el de transcriber_config.json.
OLLAMA_URL=http://localhost:11434
